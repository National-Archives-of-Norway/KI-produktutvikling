{
  "name": "ki-produktutvikling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "rag:start": "node --env-file-if-exists=.env.local scripts/rag-server.mjs",
    "test:rag": "pnpm test:node",
    "test:content-sync": "node scripts/check-content-sync.mjs",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "pricing:sync": "node scripts/pricing/sync.mjs",
    "test:pricing": "node --test tests/pricing.test.mjs",
    "test:a11y": "node scripts/a11y/native.mjs",
    "test:a11y:smoke": "node scripts/a11y/smoke.mjs",
    "test:node": "node scripts/test-node.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_html_accessibility.py'",
    "test:links": "node scripts/check-markdown-links.mjs",
    "test": "pnpm test:node && pnpm test:python && pnpm test:content-sync && pnpm test:links",
    "test:blind": "node --test tests/rag-blind.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@digitalarkivet/mui-theme": "5.1.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/cli": "4.14.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chromedriver": "157.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vnu-jar": "26.11.9"
  },
  "packageManager": "pnpm@11.25.0"
}
