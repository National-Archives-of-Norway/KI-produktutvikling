# Kopier til .env.local for lokal utvikling. Aldri commit ekte nøkler.
# I produksjon settes disse som kjøretidsvariabler/secrets for RAG-serveren.
# none = veiledning uten modell. Velg ollama eller openai-compatible for generering.
MODEL_PROVIDER=none
# RAG_*: usatt gir standard, eksplisitt tom/blank verdi er feil.
# RAG_PORT må være 1–65535; port 0 brukes bare ved direkte testinjeksjon.
RAG_PORT=3001
# Samtidige modellforespørsler per RAG-prosess (1–8). Overskytende får 429 med kilder.
RAG_MAX_CONCURRENT=1
# Tillatte nettleser-origins (scheme + vert + eventuell port), kommaseparert.
# Erstatt listen ved annen devport/delt miljø. Tom/ugyldig verdi stopper oppstart.
RAG_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Eksternt API: full HTTPS-endepunkt til Chat Completions, ikke bare basens URL.
# Bearer-autentisering. Ingen av disse skal ha NEXT_PUBLIC_-prefiks.
MODEL_API_URL=
MODEL_NAME=
MODEL_API_KEY=

# Lokal Ollama (krever MODEL_PROVIDER=ollama). URL må ha rotsti, ingen query/fragment.
# Compose setter OLLAMA_URL=http://ollama:11434 og OLLAMA_MODEL=qwen3:4b.
# Ingen andre ikke-loopback-verter eller alternative Compose-porter tillates.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434

# Valgfri portalvariabel for options.num_thread til Ollama (1–64, tom verdi avvises).
# Usatt lar Ollama velge selv. Compose setter 4 for den målte CPU-profilen.
# Dette er ikke en innebygd miljøvariabel i selve Ollama-serveren.
# OLLAMA_NUM_THREAD=4
